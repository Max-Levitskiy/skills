{
  "format": "runspore.workflow/0.2",
  "inputSchema": {
    "type": "object",
    "required": ["task"],
    "additionalProperties": false,
    "properties": {
      "task": { "type": "string", "minLength": 1, "description": "What should this run build or fix?" }
    }
  },
  "actions": {
    "worktree": {
      "kind": "command",
      "argv": [
        "sh", "-c",
        "set -e\nroot=$(git rev-parse --show-toplevel)\ndir=\"$root/../$(basename \"$root\").worktrees/$RUNSPORE_RUN_ID\"\nif [ ! -d \"$dir\" ]; then git worktree add -b \"spore/$RUNSPORE_RUN_ID\" \"$dir\" HEAD >&2; fi\ncd \"$dir\"\nprintf '{\"workdir\": \"%s\"}\\n' \"$(pwd -P)\""
      ],
      "output": "json",
      "effect": "idempotent", "outcomes": ["ok"],
      "retry": { "maxAttempts": 3 }, "timeoutMs": "600000"
    },
    "implement": {
      "kind": "command", "argv": ["claude-spore", "run"], "output": "result",
      "cwd": { "fromInput": "/context/workdir" },
      "effect": "idempotent", "outcomes": ["ok"],
      "retry": { "maxAttempts": 3 }, "timeoutMs": "3600000"
    },
    "test": {
      "kind": "command", "argv": ["npm", "test"],
      "cwd": { "fromInput": "/workdir" },
      "effect": "idempotent", "outcomes": ["ok", "red"], "exitOutcomes": { "1": "red" },
      "retry": { "maxAttempts": 3 }, "timeoutMs": "1800000"
    }
  },
  "nodes": {
    "worktree": { "action": "worktree" },
    "implement": {
      "action": "implement",
      "instructions": "steps/implement.md",
      "outputSchemas": {
        "ok": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary"],
          "properties": {
            "summary": { "type": "string", "description": "What you changed and why, in a few sentences." }
          }
        }
      },
      "input": {
        "format": { "$literal": "json" },
        "schema": { "$outputSchemas": {} },
        "tools": { "$literal": ["Read", "Glob", "Grep", "Edit", "Write", "Bash"] },
        "context": {
          "workdir": { "$get": ["nodes", "worktree", "output", "workdir"] },
          "task": { "$get": ["input", "task"] },
          "cameFrom": { "$get": ["from"] },
          "lastTest": { "$get": ["nodes", "test"], "default": null }
        }
      }
    },
    "test": {
      "action": "test",
      "input": { "workdir": { "$get": ["nodes", "worktree", "output", "workdir"] } },
      "loopLimits": { "red": 3 }
    },
    "approve": {
      "signal": "approval",
      "instructions": "steps/approve.md",
      "outputSchemas": {
        "rejected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": { "reason": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "tests_stuck": {
      "signal": "tests-stuck",
      "instructions": "steps/tests_stuck.md",
      "outputSchemas": {
        "keep-going": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "hint": { "type": "string", "description": "Advice for Claude, if any." } }
        }
      }
    },
    "done": {
      "output": {
        "task": { "$get": ["input", "task"] },
        "workdir": { "$get": ["nodes", "worktree", "output", "workdir"] },
        "summary": { "$get": ["nodes", "implement", "output", "summary"] }
      }
    },
    "stopped": {
      "error": { "code": "tests.given-up", "message": "The tests kept failing and the run was stopped." }
    }
  }
}
