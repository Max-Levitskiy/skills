#!/usr/bin/env bun
// The fake `claude` (docs/spec.md, Testing), first on PATH in the helper's specs. Everything lives
// in $FAKE_CLAUDE_DIR:
//   projects/<folder>/<uuid>.jsonl  one transcript per session, as Claude Code keeps them under
//                    $CLAUDE_CONFIG_DIR, answered as the real CLI answers --session-id and
//                    --resume (C04): an existing ID is "already in use", a missing one "not found";
//   script.json      the answers to play back in order, each {stdout?, envelope?, exit?, stderr?}:
//                    `stdout` is written as it is (so a test can send 2.0), else `envelope` is
//                    merged into a successful envelope;
//   calls.jsonl      one line per call: args, stdin, cwd, MAX_STRUCTURED_OUTPUT_RETRIES and the
//                    RUNSPORE_ variables.
// Without -p it is an interactive Claude: it records the call and waits until it is killed.
import { appendFileSync, existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const dir = process.env.FAKE_CLAUDE_DIR;
if (!dir) {
  console.error("fake claude: FAKE_CLAUDE_DIR is not set");
  process.exit(1);
}
const args = process.argv.slice(2);
const interactive = !args.includes("-p");
const stdin = interactive ? "" : await Bun.stdin.text();
const runspore = Object.fromEntries(Object.entries(process.env).filter(([key]) => key.startsWith("RUNSPORE_")));
appendFileSync(
  join(dir, "calls.jsonl"),
  `${JSON.stringify({ args, stdin, cwd: process.cwd(), retries: process.env.MAX_STRUCTURED_OUTPUT_RETRIES ?? null, env: runspore })}\n`,
);

const flag = (name: string) => {
  const i = args.indexOf(name);
  return i >= 0 ? args[i + 1] : undefined;
};
const projects = join(dir, "projects");
mkdirSync(projects, { recursive: true });
const exists = (id: string) => readdirSync(projects).some((folder) => existsSync(join(projects, folder, `${id}.jsonl`)));
const created = flag("--session-id");
const resumed = flag("--resume");
const session = created ?? resumed ?? "00000000-0000-0000-0000-000000000000";
if (created !== undefined) {
  if (exists(created)) {
    console.error(`Error: Session ID ${created} is already in use.`);
    process.exit(1);
  }
  const folder = join(projects, process.cwd().replace(/[^A-Za-z0-9]/g, "-"));
  mkdirSync(folder, { recursive: true });
  writeFileSync(join(folder, `${created}.jsonl`), "");
}
if (resumed !== undefined && !exists(resumed)) {
  console.error(`No conversation found with session ID: ${resumed}`);
  process.exit(1);
}
if (interactive) {
  // A Claude in a pane: it stays until its pane is closed.
  setInterval(() => {}, 60_000);
  await new Promise(() => {});
}

const played = join(dir, "played");
const index = existsSync(played) ? Number(readFileSync(played, "utf8")) : 0;
writeFileSync(played, String(index + 1));
const scriptFile = join(dir, "script.json");
const script = existsSync(scriptFile) ? JSON.parse(readFileSync(scriptFile, "utf8")) : [];
const answer = script[index];
if (answer === undefined) {
  console.error(`fake claude: no scripted answer for call ${index + 1}`);
  process.exit(1);
}

const envelope = {
  type: "result",
  subtype: "success",
  is_error: false,
  result: "Done.",
  session_id: session,
  num_turns: 3,
  duration_ms: 1500,
  total_cost_usd: 0.0123456,
  permission_denials: [],
  terminal_reason: "completed",
  structured_output: null,
  ...answer.envelope,
};
process.stdout.write(answer.stdout ?? JSON.stringify(envelope));
if (answer.stderr) process.stderr.write(answer.stderr);
process.exit(answer.exit ?? 0);
