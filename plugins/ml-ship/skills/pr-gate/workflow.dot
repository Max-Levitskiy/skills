// The default PR Gate graph, in SWL-DOT: https://runspore.com/docs#notation
// The agent walks it; SKILL.md says how. A label is what to do at that node.
// Replace it with the `workflow` key of the pr-gate agent config.
digraph "pr-gate" {
  dialect = "runspore/0.2";
  start   = "facts";

  facts          [label="Run the facts script on the PR the person named, else the current branch's, else the only open one. Read the conversation on the PR, by people and agents, and the repo's convention docs."];
  choose_pr      [kind="await-signal", label="No PR named, none on this branch and several open: list the open PRs, and only those, and ask which one."];
  no_pr          [kind="fail", label="The repo has no open PRs. Say so."];

  conflict       [label="The PR cannot merge as it stands. Measure how far behind it is, and read every base commit that touched its files."];
  allow_update   [kind="await-signal", label="Updating the branch is an authored change. Yes if the person already said to fix it; otherwise ask."];
  update_branch  [label="Merge the base into the PR branch keeping both sides' intent, run the repo's gates, push."];

  watch_ci       [label="Start a background CI watcher on the head SHA, unless its checks have already settled or the repo is shown to have no CI. Do not wait for it."];
  verify         [label="Work out what the change really does and who it breaks. Check every claim against the artifact. Run the repo's gates in a scratch worktree."];
  triage_reviews [label="Settle each review finding, from people or agents: fix it, push back with evidence, or ask the person with your recommendation. Push back on a person only if the person you work for agrees."];
  ask_finding    [kind="await-signal", label="Put each finding you could not settle to the person, with your recommendation."];
  ci_result      [label="Wait for the watcher, unless the person needs an answer now. Name the state CI settled in on the head SHA."];
  classify_red   [label="Read the failing logs. Compare the same check on the base branch. Decide whose failure it is."];

  allow_push     [kind="await-signal", label="Pushing to the PR branch. Yes on the person's own PR, or if they said to fix it; otherwise ask."];
  fix            [label="Fix the cause on the PR branch, all fixes in one push. Run the repo's gates first."];

  judge          [label="Decide whether the PR is ready on the head SHA. Decide whether the person asked for a merge, and whether its condition held."];
  merge          [label="Merge pinned to the validated SHA, with the repo's method, keeping the trailers. Confirm it landed."];
  report         [label="Lead with the verdict, then the evidence, the review outcomes and every gap."];
  done           [kind="complete"];

  facts          -> watch_ci       [on="ok"];
  facts          -> conflict       [on="conflicting"];
  facts          -> choose_pr      [on="ambiguous"];
  facts          -> no_pr          [on="no-open-prs"];
  choose_pr      -> facts          [on="chosen"];

  conflict       -> allow_update;
  allow_update   -> update_branch  [on="approved"];
  allow_update   -> watch_ci       [on="declined"];
  update_branch  -> facts;

  watch_ci       -> verify;
  verify         -> triage_reviews;
  triage_reviews -> ci_result      [on="ok"];
  triage_reviews -> allow_push     [on="fixes"];
  triage_reviews -> ask_finding    [on="questions"];
  ask_finding    -> triage_reviews [on="answered"];
  ask_finding    -> ci_result      [on="no-answer"];

  ci_result      -> judge          [on="green"];
  ci_result      -> judge          [on="nothing-ran"];
  ci_result      -> judge          [on="pending"];
  ci_result      -> classify_red   [on="red"];
  classify_red   -> allow_push     [on="regression"];
  classify_red   -> judge          [on="pre-existing"];
  classify_red   -> judge          [on="unexplained"];

  allow_push     -> fix            [on="approved"];
  allow_push     -> judge          [on="declined"];
  fix            -> facts          [on="ok", label="the head moved, so everything is checked again"];
  fix            -> report         [on="exhausted"];

  judge          -> merge          [on="merge"];
  judge          -> report         [on="verdict"];
  merge          -> report         [on="ok"];
  merge          -> facts          [on="moved"];
  merge          -> report         [on="refused"];
  report         -> done;
}
